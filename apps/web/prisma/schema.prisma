generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum SectionCode {
  RW
  MATH
}

enum QuestionType {
  RW_PASSAGE_MCQ
  MATH_MCQ
  MATH_SPR
  GRAPH_MCQ
}

enum SessionStatus {
  IN_PROGRESS
  MASTERED
}

enum SectionAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXITED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  skillProgress   SkillProgress[]
  skillSessions   SkillSession[]
  sectionAttempts SectionAttempt[]
}

model Section {
  id        String      @id @default(uuid())
  code      SectionCode @unique
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  categories  Category[]
  microSkills MicroSkill[]
}

model Category {
  id        String   @id @default(uuid())
  sectionId String
  name      String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section     Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  microSkills MicroSkill[]
}

model MicroSkill {
  id         String   @id @default(uuid())
  sectionId  String
  categoryId String
  code       String   @unique   // e.g. RW-MS-001
  name       String
  active     Boolean  @default(true)
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  questions Question[]

  progress SkillProgress[]
  sessions SkillSession[]

  @@index([sectionId])
  @@index([categoryId])
}

model Question {
  id                   String       @id @default(uuid())
  microSkillId          String
  questionType          QuestionType
  passageHtml           String?      // RW passage (optional)
  questionHtml          String
  choicesJson           Json?        // for MCQ: [{id:"A", textHtml:"..."}]
  correctAnswer         String       // "A"/"B"/... or SPR value
  explanationHtml       String
  complexity            String       // Easy/Medium/Hard (string for now)
  complexityReasonHtml  String
  assetUrl              String?      // graph image later
  active                Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  sequenceNo            Int

  @@unique([microSkillId, sequenceNo])
  @@index([microSkillId, active, sequenceNo])

  microSkill MicroSkill @relation(fields: [microSkillId], references: [id], onDelete: Cascade)

  @@index([microSkillId])
  @@index([questionType])
}


model SectionAttempt {
  id               String               @id @default(uuid())
  userId           String
  sectionId        String
  sectionType      SectionCode
  attemptNo        Int
  status           SectionAttemptStatus @default(IN_PROGRESS)
  currentIndex     Int                  @default(0)
  remainingSeconds Int                  @default(0)
  selectedJson     Json                 @default("{}")
  reviewJson       Json                 @default("{}")
  startedAt        DateTime             @default(now())
  endedAt          DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sectionId])
  @@index([userId, status])
  @@unique([userId, sectionId, attemptNo])
}

model SkillProgress {
  id           String   @id @default(uuid())
  userId       String
  microSkillId String
  masteryPct   Int      @default(0) // 0..100
  masteredCount Int     @default(0)
  totalQuestions Int    @default(30)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  microSkill MicroSkill @relation(fields: [microSkillId], references: [id], onDelete: Cascade)

  @@unique([userId, microSkillId])
  @@index([microSkillId])
}

model SkillSession {
  id            String        @id @default(uuid())
  userId        String
  microSkillId  String
  status        SessionStatus @default(IN_PROGRESS)
  cycle         Int           @default(1)
  queueJson     Json          // list of questionIds for current cycle
  pos           Int           @default(0) // index in queueJson
  nextQueueJson Json          @default("[]")
  masteredJson  Json          @default("[]") // list of mastered questionIds (set-like)
  updatedAt     DateTime      @updatedAt
  createdAt     DateTime      @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  microSkill MicroSkill @relation(fields: [microSkillId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([microSkillId])
  @@unique([userId, microSkillId])
}
